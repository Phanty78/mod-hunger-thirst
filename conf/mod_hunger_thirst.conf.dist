[worldserver]

########################################################################################################################
# mod-hunger-thirst
#
# Tracks satiety and hydration per character, warns the player as the gauges
# fall and, in survival mode, applies hunger states from the satiety gauge and
# thirst states from the hydration gauge. The module never deals damage and
# never kills a character.
#
# All player-facing messages (chat warnings, login summary, status command)
# are in English.
#
# Two independent switches:
#   - HungerThirst.Enable is the master switch. When 0 the module tracks
#     nothing at all: no state is loaded or saved, Tick/CreditConsumable do
#     nothing, and no login summary is sent. If AddonEnable=1, one synthetic
#     disabled snapshot (mode=0, loaded=1) is still sent at login so the addon
#     can display "Disabled". Commands still exist; the status command reports
#     the module as disabled.
#   - HungerThirst.Mode selects the simulation. "off" keeps the module loaded
#     and the state persisted/queryable, but does not decay the gauges, warn,
#     apply states, blur, or push periodic addon updates (a login snapshot
#     with mode=0 is still sent when AddonEnable=1). "advisory" decays and
#     warns but never applies states and never blurs. "survival" adds hunger
#     states and thirst states, the penalties they carry and the thirst blur.
#
# Effects in survival mode:
#   - Hunger states (satiety gauge, see HungerThirst.HungerStates): hunger
#     deals no damage. Satiety at or below WarningThreshold (warning or
#     critical band, above 0) applies spell 52749 with the penalties of
#     HungerStatePenaltyPct; satiety at 0 applies spell 55316 with
#     HungerStarvingPenaltyPct instead. Each state reduces movement speed and
#     damage dealt, and increases damage taken, by its percentage. The state
#     is removed when satiety returns to the normal band (Hysteresis
#     applies), when HungerStates=0, or outside survival mode.
#   - Thirst states (hydration gauge, see HungerThirst.ThirstStates): thirst
#     deals no damage. Hydration at or below WarningThreshold (warning or
#     critical band, above 0) applies spell 25696 "Drink" with the
#     penalties of ThirstStatePenaltyPct; hydration at 0 applies spell 5909
#     "Watered-down Beer" with ThirstDehydratedPenaltyPct instead. Each state
#     reduces mana regeneration, magical damage done and healing done by its
#     percentage; physical, ranged and pet damage are unaffected, and so is
#     damage taken. The state is removed when hydration returns to the normal
#     band (Hysteresis included), when ThirstStates=0, or outside survival
#     mode. The legacy thirst spells of earlier module versions, 43155,
#     46583, 14869 and 14870, are no longer applied; their auras are
#     removed automatically from characters that still carry them.
#   - Mana regeneration: the canonical
#     SPELL_AURA_MOD_POWER_REGEN_PERCENT aura is used, which in this core
#     only scales spirit-based regeneration. Flat mp5 regeneration is not
#     reduced; no core patch is involved.
#   - Thirst blur (see ThirstBlurIntervalMs/ThirstBlurDurationMs): while a
#     thirst state is active, a client-side blur pulses for
#     ThirstBlurDurationMs every ThirstBlurIntervalMs (2 s every 10 s by
#     default) with intensity 35 for state 1 and 45 for state 2. It uses the
#     fake inebriation player field (PLAYER_FAKE_INEBRIATION): no aura, no
#     icon and no gameplay effect. Both intensities stay below the client's
#     drunk threshold (50), so the field only tints the screen and never
#     switches the client to the drunk stance and its unsteady walk
#     animation. The blur is visual only and is not what caused the sliding
#     walk reported on a real client: the character slid because the retired
#     dehydrated state spell 14870 has a stun in the stock client data, so
#     the client played the stunned stand animation while the server let the
#     character move. The current dehydrated spell, 5909, carries the same
#     icon (INV_Drink_04) but a stat aura on the client, which plays no
#     animation.
#     No pulse is sent while a pause applies (see below) or once the state
#     ends; a pulse in progress is cleared.
#   - No exhaustion damage: thirst never removes health, and the module never
#     causes a death (satiety and hydration alike).
#
# All changes can be applied with ".reload config"; they take effect at the
# next tick. Two exceptions: HungerStatePenaltyPct,
# HungerStarvingPenaltyPct, ThirstStatePenaltyPct and
# ThirstDehydratedPenaltyPct are baked into the state spells at startup, so
# changing them requires a server restart; and switching Enable from 0 to 1
# does not load state for players already online (it was dropped while
# disabled) - they must reconnect or use ".hungerthirst set"; new logins are
# unaffected. ThirstStates, ThirstBlurIntervalMs and ThirstBlurDurationMs
# are read live and do not need a restart.
#
# Some pauses are always active and have no configuration key: dead players,
# characters whose state is still loading (or failed to load), and players
# currently in a duel are never decayed or warned. Whenever a pause applies
# (including the configured taxi, battleground, arena and GM exemptions) the
# thirst blur is cleared, but state auras already applied stay in place.
#
# Persistence uses acore_characters.hunger_thirst_state, created
# automatically at startup:
#   guid INT UNSIGNED PRIMARY KEY
#   satiety DECIMAL(5,2) NOT NULL DEFAULT 100.00
#   hydration DECIMAL(5,2) NOT NULL DEFAULT 100.00
#   updated_at BIGINT UNSIGNED NOT NULL DEFAULT 0 (epoch milliseconds)
# Saves are conditional on updated_at, so an older save never overwrites a
# newer one. If the table cannot be created or verified, the simulation is
# suspended for the affected players: no tick (decay, warnings, states,
# blur), no save, no consumable credit and no periodic addon update. Login
# is never blocked; with an active mode and ShowLoginSummary=1 the player
# receives a "Persistence unavailable" chat notice, and when AddonEnable=1
# the addon displays the same status. The state stays unloaded for the whole
# session, so a reconnect is required once the table is available again.
#
# Validation performed while loading:
#   - unknown Mode -> off (LOG_ERROR)
#   - 0 <= CriticalThreshold < WarningThreshold <= 100
#   - HungerStatePenaltyPct, HungerStarvingPenaltyPct,
#     ThirstStatePenaltyPct and ThirstDehydratedPenaltyPct clamped to 0..90
#   - all intervals/cooldowns >= 1000 ms
#   - ThirstBlurDurationMs clamped to >= 100 ms
#   - all gauges/percentages/multipliers clamped to their documented range
########################################################################################################################

#
#    HungerThirst.Enable
#        Master on/off switch. See the header comment above for the
#        difference with HungerThirst.Mode.
#        Default: 1
#
HungerThirst.Enable = 1

#
#    HungerThirst.Mode
#        Simulation mode:
#          off      - loaded and persisted, but no decay, warnings, states,
#                     blur or periodic addon updates (default, safe
#                     installation). A login snapshot with mode=0 is still
#                     sent if AddonEnable=1.
#          advisory - decay, chat warnings, login summary and addon updates;
#                     no states, no blur and no penalty, even at 0/0.
#          survival - everything advisory does, plus hunger states and thirst
#                     states (visible auras and their penalties) and the
#                     thirst blur.
#        Case-insensitive. An unknown value falls back to "off" and logs an
#        error.
#        Default: off
#
HungerThirst.Mode = off

#
#    HungerThirst.SatietyDecayPerMinute
#        Satiety points lost per minute of active play (before the rest and
#        instance multipliers). 0 disables satiety decay. Clamped to 0..100.
#        Default: 0.50
#
HungerThirst.SatietyDecayPerMinute = 0.50

#
#    HungerThirst.HydrationDecayPerMinute
#        Hydration points lost per minute of active play (before multipliers).
#        Hydration normally drains slightly faster than satiety. Clamped to
#        0..100.
#        Default: 0.75
#
HungerThirst.HydrationDecayPerMinute = 0.75

#
#    HungerThirst.RestMultiplier
#        Decay multiplier while resting (REST_FLAG_IN_TAVERN,
#        REST_FLAG_IN_CITY or REST_FLAG_IN_FACTION_AREA). Multiplies the
#        per-tick decay. Clamped to 0..10.
#        Default: 0.50
#
HungerThirst.RestMultiplier = 0.50

#
#    HungerThirst.InstanceMultiplier
#        Decay multiplier while inside a dungeon or raid map
#        (Map::IsDungeon). Stacks multiplicatively with RestMultiplier if a
#        rest area is also an instance. Clamped to 0..10.
#        Default: 1.00
#
HungerThirst.InstanceMultiplier = 1.00

#
#    HungerThirst.FlyingMountMultiplier
#        Decay multiplier while on a flying mount
#        Stacks with other multipliers
#        Clamped to 0..10.
#        Default: 3.00
#
HungerThirst.FlyingMountMultiplier = 3.00

#
#    HungerThirst.GroundMountMultiplier
#        Decay multiplier while inside a dungeon or raid map
#        Stacks with other multipliers
#        rest area is also an instance. Clamped to 0..10.
#        Default: 2.00
#
HungerThirst.GroundMountMultiplier = 2.00

#
#    HungerThirst.PauseOnTaxi
#        Suspend decay, warnings and the thirst blur while the player is on a
#        taxi flight. Thirst state auras already applied stay in place.
#        Default: 1
#
HungerThirst.PauseOnTaxi = 1

#
#    HungerThirst.PauseInBattleground
#        Suspend decay, warnings, periodic addon updates and the thirst blur
#        while the player is in a battleground or arena (the arena switch
#        below is an additional guard). With both switches at 0, decay,
#        warnings and blur keep running.
#        Default: 1
#
HungerThirst.PauseInBattleground = 1

#
#    HungerThirst.PauseInArena
#        Suspend decay, warnings, periodic addon updates and the thirst blur
#        while the player is in an arena match. With this and
#        PauseInBattleground at 0, decay, warnings and blur keep running.
#        Default: 1
#
HungerThirst.PauseInArena = 1

#
#    HungerThirst.ExemptGMs
#        Suspend the module for accounts with GM security, including the
#        thirst blur. Handy while debugging.
#        Default: 1
#
HungerThirst.ExemptGMs = 1

#
#    HungerThirst.WarningThreshold
#        Upper bound of the "warning" band, in gauge points. A gauge above
#        this value is normal; at or below it the player is hungry/thirsty.
#        In survival mode this is also the threshold at which the hunger
#        state (satiety) and the thirst state (hydration) begin, see
#        HungerThirst.HungerStates and HungerThirst.ThirstStates; each state
#        is removed only when its gauge returns to the normal band,
#        Hysteresis included. Must be <= 100 and greater than
#        CriticalThreshold.
#        Default: 30
#
HungerThirst.WarningThreshold = 30

#
#    HungerThirst.CriticalThreshold
#        Upper bound of the "critical" band, in gauge points. At or below it
#        the gauge is very low. Survival thirst treats the warning and
#        critical bands the same (state 1, spell 25696); hydration at 0 is
#        empty and uses state 2 (spell 5909). Satiety never uses this band
#        beyond the warning state. Also used for band labels and advisory
#        warnings. Must be lower than WarningThreshold.
#        Default: 10
#
HungerThirst.CriticalThreshold = 10

#
#    HungerThirst.HungerStates
#        Survival only. When 1 (default), the satiety gauge applies a visible
#        hunger state:
#          - satiety at or below WarningThreshold (warning or critical band,
#            above 0): spell 52749 "Voracious Appetite" with the penalties of
#            HungerStatePenaltyPct;
#          - satiety at 0: spell 55316 "Ravenous Hunger" with the penalties
#            of HungerStarvingPenaltyPct, replacing spell 52749.
#        Both states reduce movement speed and damage dealt, and increase
#        damage taken, by their percentage. The state is removed when satiety
#        returns to the normal band (Hysteresis included), outside survival
#        mode, and when this option is 0 - hunger then has no gameplay effect
#        at all. If either spell cannot be patched at startup, states are
#        disabled and an error is logged.
#        Default: 1
#
HungerThirst.HungerStates = 1

#
#    HungerThirst.HungerStatePenaltyPct
#        Survival only, HungerStates=1: penalty while satiety is in the
#        warning or critical band (above 0). Movement speed and damage dealt
#        are reduced by this percentage; damage taken is increased by the
#        same percentage. Clamped to 0..90.
#        Baked into spell 52749 when the worldserver starts: changing this
#        value requires a restart, ".reload config" is not enough.
#        Default: 10.00
#
HungerThirst.HungerStatePenaltyPct = 10.00

#
#    HungerThirst.HungerStarvingPenaltyPct
#        Survival only, HungerStates=1: penalty while satiety is at 0,
#        replacing HungerStatePenaltyPct. Movement speed and damage dealt are
#        reduced by this percentage; damage taken is increased by the same
#        percentage. Clamped to 0..90.
#        Baked into spell 55316 when the worldserver starts: changing this
#        value requires a restart, ".reload config" is not enough.
#        Default: 30.00
#
HungerThirst.HungerStarvingPenaltyPct = 30.00

#
#    HungerThirst.ThirstStates
#        Survival only. When 1 (default), the hydration gauge applies a
#        visible thirst state:
#          - hydration at or below WarningThreshold (warning or critical
#            band, above 0): spell 25696 "Drink" with the
#            penalties of ThirstStatePenaltyPct;
#          - hydration at 0: spell 5909 "Watered-down Beer" with the
#            penalties of ThirstDehydratedPenaltyPct, replacing spell 25696.
#        Both states reduce mana regeneration, magical damage done and
#        healing done by their percentage. Physical, ranged and pet damage
#        are unaffected, and so is damage taken. The state is removed when
#        hydration returns to the normal band (Hysteresis included), outside
#        survival mode, and when this option is 0 - thirst then has no
#        gameplay effect at all. If either spell cannot be patched at
#        startup, states are disabled and an error is logged. The spells
#        keep their Blizzard names and icons, and their client tooltips keep
#        the original Blizzard descriptions, which do not match the module
#        effects. The server cannot rewrite those tooltips without a client
#        patch: the chat message sent when the state begins is the
#        authoritative description, and the optional client addon overrides
#        the tooltips of all four state auras with the real effects and the
#        remedy (eat or drink). Auras of the legacy thirst spells 43155,
#        46583, 14869 and 14870 are removed automatically from characters
#        that still carry them.
#        Default: 1
#
HungerThirst.ThirstStates = 1

#
#    HungerThirst.ThirstStatePenaltyPct
#        Survival only, ThirstStates=1: penalty while hydration is in the
#        warning or critical band (above 0). Mana regeneration (spirit-based
#        regeneration only, see the header), magical damage done and healing
#        done are reduced by this percentage. Clamped to 0..90.
#        Baked into spell 25696 when the worldserver starts: changing this
#        value requires a restart, ".reload config" is not enough.
#        Default: 10.00
#
HungerThirst.ThirstStatePenaltyPct = 10.00

#
#    HungerThirst.ThirstDehydratedPenaltyPct
#        Survival only, ThirstStates=1: penalty while hydration is at 0,
#        replacing ThirstStatePenaltyPct. Mana regeneration (spirit-based
#        regeneration only, see the header), magical damage done and healing
#        done are reduced by this percentage. Clamped to 0..90.
#        Baked into spell 5909 when the worldserver starts: changing this
#        value requires a restart, ".reload config" is not enough.
#        Default: 30.00
#
HungerThirst.ThirstDehydratedPenaltyPct = 30.00

#
#    HungerThirst.ThirstBlurIntervalMs
#        Survival only, ThirstStates=1: milliseconds between two blur
#        pulses. The blur is a client-side visual only: it writes the fake
#        inebriation player field (PLAYER_FAKE_INEBRIATION), with no aura, no
#        icon and no gameplay effect. No pulse is sent while a pause applies
#        (dead, state not loaded, duel, or a configured
#        taxi/battleground/arena/GM pause), in advisory/off mode or with
#        ThirstStates=0; a pulse in progress is cleared. Values below 1000
#        are clamped to 1000.
#        Default: 10000
#
HungerThirst.ThirstBlurIntervalMs = 10000

#
#    HungerThirst.ThirstBlurDurationMs
#        Survival only, ThirstStates=1: duration of one blur pulse in
#        milliseconds. The intensity is 35 while hydration is in the warning
#        or critical band (state 1) and 45 at 0 (state 2). Both values are
#        below the client's drunk threshold (50): the field is visual only
#        and does not put the character into the drunk stance and its
#        unsteady walk animation. Values below 100 are clamped to 100.
#        Default: 2000
#
HungerThirst.ThirstBlurDurationMs = 2000

#
#    HungerThirst.FoodSatietyGain
#        Satiety restored when a food aura is credited (spell specific FOOD or
#        FOOD_AND_DRINK). The configured gain is clamped to 0..100 and the
#        gauge itself to 100.
#        Default: 30.00
#
HungerThirst.FoodSatietyGain = 30.00

#
#    HungerThirst.DrinkHydrationGain
#        Hydration restored when a drink aura is credited (spell specific
#        DRINK or FOOD_AND_DRINK). The configured gain is clamped to 0..100 and
#        the gauge itself to 100.
#        Default: 35.00
#
HungerThirst.DrinkHydrationGain = 35.00

#
#    HungerThirst.RestoreCooldownMs
#        Anti-double-credit window for item-based food/drink only: the same
#        cast item entry is credited at most once per this window (refresh
#        callbacks for the same bite are ignored). Auras without a cast item
#        use AuraCreditCooldownMs instead. Values below 1000 are clamped to
#        1000.
#        Default: 1000
#
HungerThirst.RestoreCooldownMs = 1000

#
#    HungerThirst.AuraCreditCooldownMs
#        Anti-double-credit window for every food/drink aura without a cast
#        item (feast, gameobject, player-cast aura). The credit is keyed by
#        (spellId, casterGuid) and the actual window is max(this value, aura
#        duration), so one feast tick credits a player once, not once per
#        server tick. Values below 1000 are clamped to 1000.
#        Default: 30000
#
HungerThirst.AuraCreditCooldownMs = 30000

#
#    HungerThirst.StartingSatiety
#        Satiety assigned to a character with no stored row (new character or
#        first login after installing the module). Clamped to 0..100.
#        Default: 100.00
#
HungerThirst.StartingSatiety = 100.00

#
#    HungerThirst.StartingHydration
#        Hydration assigned to a character with no stored row. Clamped to
#        0..100.
#        Default: 100.00
#
HungerThirst.StartingHydration = 100.00

#
#    HungerThirst.Hysteresis
#        Points a gauge must gain strictly above the threshold it is leaving
#        before the band improves. Bands always worsen immediately. 0 disables
#        hysteresis. Clamped to 0..(100 - WarningThreshold) so a full gauge
#        can always leave the warning band.
#        Default: 2.00
#
HungerThirst.Hysteresis = 2.00

#
#    HungerThirst.ShowLoginSummary
#        Send a one-line chat summary (mode, gauges, bands) on login
#        when the module is enabled and not in mode off.
#        Default: 1
#
HungerThirst.ShowLoginSummary = 1

#
#    HungerThirst.DebugLog
#        Emit LOG_DEBUG lines for state load/save, consumable credits and
#        thirst state/blur transitions.
#        Default: 0
#
HungerThirst.DebugLog = 0

#
#    HungerThirst.AddonEnable
#        Send the addon state packet when Enable=1, AddonEnable=1 and the
#        player's state is loaded. A packet is sent at login even in mode off
#        (mode=0) so the addon can display "Disabled"; periodic packets only
#        run while Tick is active (advisory/survival, not paused). The packet
#        is a CHAT_MSG_WHISPER / LANG_ADDON message sent directly to the
#        player:
#
#            HT<TAB>satiety<TAB>hydration<TAB>mode<TAB>lethal<TAB>loaded<TAB>persistence<TAB>satBand<TAB>hydBand
#
#        The payload is the prefix plus exactly 8 fields (no extra field):
#        satiety/hydration use one decimal; mode is 0=off, 1=advisory,
#        2=survival; bands are 0=normal, 1=warning, 2=critical, 3=empty;
#        lethal is reserved for addon compatibility and always sent as 0;
#        loaded/persistence are 0/1. No colors.
#        Default: 1
#
HungerThirst.AddonEnable = 1

#
#    HungerThirst.AddonUpdateIntervalMs
#        Periodic addon packet cadence in milliseconds while Tick is active.
#        The login snapshot is sent immediately. Values below 1000 are clamped
#        to 1000.
#        Default: 1000
#
HungerThirst.AddonUpdateIntervalMs = 1000

#
#    HungerThirst.AddonPrefix
#        Prefix written as the first tab-separated field of the addon packet.
#        Must match the addon's prefix. An empty value falls back to "HT".
#        Default: HT
#
HungerThirst.AddonPrefix = "HT"
